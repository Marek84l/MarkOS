[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'yetanotherradio@io.github.buddysirjava']
favorite-apps=['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.Calculator.desktop', 'net.nokyan.Resources.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dash-max-icon-size=32
dock-fixed=true
autohide=false
intellihide=false
transparency-mode='FIXED'
background-opacity=0.0
running-indicator-style='DOT'
show-show-apps-button=true
show-apps-at-top=false
show-apps-always-in-the-edge=false

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/markos/markos-cosmic.png'
picture-uri-dark='file:///usr/share/backgrounds/markos/markos-cosmic.png'
picture-options='zoom'

[org/gnome/Ptyxis]
use-system-font=false
font-name='JetBrainsMono Nerd Font 11'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='purple'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

